{
  "extends": [
    "next/core-web-vitals"
  ],

  "plugins": [
    "i18next"
  ],

  "rules": {

    "@typescript-eslint/no-explicit-any": "off",

    "react-hooks/set-state-in-effect": "off",

    "react-hooks/immutability": "off",

    "react-hooks/exhaustive-deps": "off",

    "i18next/no-literal-string": [

      "warn",

      {

        "markupOnly": true,

        "ignoreAttribute": [

          "className",
          "href",
          "style",
          "type",
          "to",
          "src",
          "alt"
        ]
      }
    ]
  }
}